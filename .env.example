# ── Required ─────────────────────────────────────────────
# On Railway set this to exactly:  ${{Postgres.DATABASE_URL}}
# (a reference to your Postgres service — do NOT copy the local example below)
# Local development example:
DATABASE_URL="postgresql://tcs:tcs@localhost:5432/tcs"
# Public URL of this deployment (no trailing slash). Production: https://tcountyconnect.com
APP_URL="https://tcountyconnect.com"

# Domain redirects (build time). Pages on LEGACY_HOSTS 301-redirect to CANONICAL_HOST (same path + query);
# /api/* is not redirected. www.CANONICAL_HOST also redirects to CANONICAL_HOST. Defaults shown.
CANONICAL_HOST="tcountyconnect.com"
LEGACY_HOSTS="tcountyspotlight.com,www.tcountyspotlight.com"
# First administrator (created on first deploy only if the email doesn't exist)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="a-long-unique-password"

# ── WordPress migration ──────────────────────────────────
WP_BASE_URL="https://tcountyspotlight.com"
# Optional: WordPress Application Password (Users → Profile → Application Passwords)
# Needed to import drafts, scheduled, pending and private content.
WP_USERNAME=""
WP_APP_PASSWORD=""

# ── Image storage (recommended: Railway Bucket, Cloudflare R2, S3) ──
# If unset, uploaded images are stored in PostgreSQL (persistent, but larger DB backups).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for objects, e.g. https://media.tcountyspotlight.com
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"

# ── Email (password resets, verification, admin notices) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@tcountyspotlight.com"

# ── Stripe (keep test keys until plans are approved) ─────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Web push (npx web-push generate-vapid-keys) ──────────
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""  # same value as VAPID_PUBLIC_KEY (baked in at build time)
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── Scheduled jobs (Railway cron service calls /api/cron/) ─
CRON_SECRET=""

# ── Government Watch (Admin → Government Watch) ──────────
# AI analysis of collected meeting documents and article drafts. Without a key, documents are still collected.
ANTHROPIC_API_KEY=""
# Optional: Claude model for analysis (default claude-opus-5-5; claude-haiku-5-5 costs less per document)
GOVWATCH_MODEL=""
# Optional records inbox (a dedicated mailbox clerks email minutes to), read by IMAP every 30 minutes
GOVWATCH_IMAP_HOST=""
GOVWATCH_IMAP_PORT="993"
GOVWATCH_IMAP_USER=""
GOVWATCH_IMAP_PASSWORD=""   # an app password
GOVWATCH_RECORDS_EMAIL=""   # the address shown in admin, e.g. records@tcountyconnect.com
