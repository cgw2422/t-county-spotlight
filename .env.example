# ── Required ─────────────────────────────────────────────
# Railway: reference the Postgres service →  ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host:5432/tcountyspotlight"
# Public URL of this deployment (no trailing slash)
APP_URL="https://tcountyspotlight-staging.up.railway.app"
# First administrator (created on first deploy only if the email doesn't exist)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="a-long-unique-password"

# ── WordPress migration ──────────────────────────────────
WP_BASE_URL="https://tcountyspotlight.com"
# Optional: WordPress Application Password (Users → Profile → Application Passwords)
# Needed to import drafts, scheduled, pending and private content.
WP_USERNAME=""
WP_APP_PASSWORD=""

# ── Image storage (recommended: Railway Bucket, Cloudflare R2, S3) ──
# If unset, uploaded images are stored in PostgreSQL (persistent, but larger DB backups).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for objects, e.g. https://media.tcountyspotlight.com
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"

# ── Email (password resets, verification, admin notices) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@tcountyspotlight.com"

# ── Stripe (keep test keys until plans are approved) ─────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Web push (npx web-push generate-vapid-keys) ──────────
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""  # same value as VAPID_PUBLIC_KEY (baked in at build time)
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── Scheduled jobs (Railway cron service calls /api/cron/) ─
CRON_SECRET=""
