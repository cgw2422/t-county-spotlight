// TCountySpotlight database schema
// Conventions:
//  - wpId / wpType columns preserve original WordPress identifiers so the
//    importer can be re-run without creating duplicates.
//  - Editorial records use soft deletion (deletedAt) so nothing is lost.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Users & auth ─────────────────────────────

enum Role {
  ADMIN
  EDITOR
  BUSINESS_OWNER
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  name            String?
  role            Role       @default(MEMBER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  totpSecret      String?
  totpEnabled     Boolean    @default(false)
  notificationPrefs Json?
  /// My T County: preferred community (a TUSCARAWAS_CITIES value) — null means all of Tuscarawas County
  homeCommunity      String?
  /// Additional communities of interest
  extraCommunities   String[] @default([])
  /// Favorite content categories (allowlisted keys, see src/lib/my-t-county.ts)
  interestKeys       String[] @default([])
  lastLoginAt     DateTime?
  firstName       String?
  lastName        String?
  /// Set for admin-issued temporary passwords: the user must choose a new password before using any dashboard.
  mustChangePassword Boolean  @default(false)
  passwordChangedAt  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions          Session[]
  tokens            VerificationToken[]
  businesses        BusinessOwner[]
  savedItems        SavedItem[]
  follows           BusinessFollow[]
  redemptions       PromotionRedemption[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]
  articles          Article[]           @relation("ArticleAuthor")
  revisions         ArticleRevision[]
  media             Media[]
  applications      BusinessApplication[] @relation("ApplicationSubmitter")
  submittedEvents   Event[]             @relation("EventSubmitter")
  organizations     OrganizationMember[]
  organizationClaims OrganizationClaim[]
  pledges           NeedPledge[]
  volunteerSignups  VolunteerSignup[]
  newsletterSubscriber NewsletterSubscriber?
  invitations       AccountInvitation[] @relation("InvitedUser")
  invitationsSent   AccountInvitation[] @relation("InvitedBy")
}

model Session {
  id          String   @id // sha256 of the cookie token
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  needs2fa    Boolean  @default(false)
  userAgent   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ───────────────────────────── Businesses ─────────────────────────────

enum PublishStatus {
  DRAFT
  PENDING
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

model BusinessCategory {
  id          String     @id @default(cuid())
  wpId        Int?
  wpTaxonomy  String?
  name        String
  slug        String     @unique
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  businesses  Business[]
  createdAt   DateTime   @default(now())
}

model Business {
  id             String        @id @default(cuid())
  wpId           Int?
  wpType         String?
  slug           String        @unique
  name           String
  tagline        String?
  description    String?       // HTML
  story          String?       // HTML
  logoUrl        String?
  coverUrl       String?
  coverFocusX    Int           @default(50) // cover focal point, % from left (0–100)
  coverFocusY    Int           @default(50) // cover focal point, % from top (0–100)
  address        String?
  city           String?
  state          String?       @default("OH")
  zip            String?
  latitude       Float?
  longitude      Float?
  phone          String?
  email          String?
  emailPublic    Boolean       @default(false)
  website        String?
  socials        Json?         // { facebook, instagram, x, tiktok, youtube, linkedin }
  hours          Json?         // [{ day: "Mon", open: "09:00", close: "17:00", closed: false }]
  status         PublishStatus @default(PUBLISHED)
  isFeatured     Boolean       @default(false)
  isSpotlighted  Boolean       @default(false) // editorial spotlight (never implied by payment)
  seoTitle       String?
  seoDescription String?
  legacyPath     String?       @unique
  wpMeta         Json?
  // Google Business listing (Place ID may be stored indefinitely per Google terms)
  googlePlaceId         String?
  googleMapsUrl         String?
  googleReviewsEnabled  Boolean   @default(true)
  // Food trucks reuse the business profile + owner accounts
  isFoodTruck    Boolean       @default(false)
  cuisine        String?       // "BBQ", "Tacos", "Desserts"…
  menuUrl        String?       // link to an existing online menu
  googlePlaceVerifiedAt DateTime?
  publishedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  categories    BusinessCategory[]
  photos        BusinessPhoto[]
  owners        BusinessOwner[]
  articles      ArticleBusiness[]
  events        Event[]
  promotions    Promotion[]
  updates       BusinessUpdate[]
  followers     BusinessFollow[]
  subscriptions Subscription[]
  payments      Payment[]
  placements    Placement[]
  jobs          Job[]
  pulseResults  PulseResult[]
  offeringSections BusinessOfferingSection[]
  foodTruckStops FoodTruckStop[]
  applications  BusinessApplication[]

  @@unique([wpType, wpId])
  @@index([status, deletedAt])
  @@index([city])
}

model BusinessPhoto {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  caption    String?
  sortOrder  Int      @default(0)
  /// The photo shown first / used as the gallery's lead image.
  isPrimary  Boolean  @default(false)
  /// Chosen by the owner to stay visible when the listing is on the Free plan
  /// (photos are never deleted on downgrade; only the allowed number is shown).
  visibleOnFree Boolean @default(false)
  createdAt  DateTime @default(now())
}

enum OwnerRole {
  OWNER
  MANAGER
}

model BusinessOwner {
  userId     String
  businessId String
  role       OwnerRole @default(OWNER)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@id([userId, businessId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model BusinessApplication {
  id           String       @id @default(cuid())
  wpId         Int?         @unique
  businessName String
  contactName  String?
  email        String
  phone        String?
  website      String?
  address      String?
  city         String?
  category     String?
  message      String?
  wantsSpotlight Boolean    @default(false)
  data         Json?
  status       ReviewStatus @default(PENDING)
  reviewNote   String?
  userId       String?
  user         User?        @relation("ApplicationSubmitter", fields: [userId], references: [id])
  businessId   String?
  business     Business?    @relation(fields: [businessId], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
}

enum BusinessUpdateKind {
  GENERAL
  COMING_SOON
  RECENTLY_OPENED
  RELOCATING
  EXPANDING
}

/// Business news. kind != GENERAL makes it a "New & Coming Soon" announcement.
/// businessId is optional so staff can announce a business that has no listing yet.
model BusinessUpdate {
  id              String             @id @default(cuid())
  businessId      String?
  business        Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind            BusinessUpdateKind @default(GENERAL)
  title           String
  body            String
  imageUrl        String?
  photos          String[]           @default([])
  /// Name/location for announcements without a listing
  businessName    String?
  address         String?
  city            String?
  /// Only a date that was actually announced — never invented
  effectiveDate   DateTime?
  /// Free-text timing when no exact date exists, e.g. "Spring 2027"
  dateNote        String?
  linkUrl         String?
  /// After this, the item leaves prominent (homepage) placement but stays in the archive
  featuredUntil   DateTime?
  submittedById   String?
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  status          PublishStatus      @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([kind, status])
}

model BusinessFollow {
  userId     String
  businessId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, businessId])
}

// ───────────────────────────── Editorial ─────────────────────────────

enum ArticleStatus {
  DRAFT
  PENDING
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
}

enum ArticleKind {
  SPOTLIGHT
  NEWS
  ANNOUNCEMENT
  THINGS_TO_DO
  GENERAL
}

model Category {
  id          String    @id @default(cuid())
  wpId        Int?      @unique
  name        String
  slug        String    @unique
  description String?
  articles    Article[]
}

model Tag {
  id       String    @id @default(cuid())
  wpId     Int?      @unique
  name     String
  slug     String    @unique
  articles Article[]
}

model Article {
  id               String        @id @default(cuid())
  wpId             Int?
  wpType           String?
  slug             String        @unique
  title            String
  excerpt          String?
  content          String        // HTML, preserved verbatim from WordPress (with media URLs rewritten)
  originalContent  String?       // untouched WordPress HTML, kept for audit / rollback
  featuredImageUrl String?
  featuredImageAlt String?
  status           ArticleStatus @default(DRAFT)
  kind             ArticleKind   @default(GENERAL)
  /// Community (TUSCARAWAS_CITIES value) this item is about; null = countywide
  city             String?
  /// Community updates leave prominent placement after this (archive kept)
  expiresAt        DateTime?
  publishedAt      DateTime?
  authorName       String?
  authorId         String?
  author           User?         @relation("ArticleAuthor", fields: [authorId], references: [id])
  seoTitle         String?
  seoDescription   String?
  ogImageUrl       String?
  legacyPath       String?       @unique
  isFeatured       Boolean       @default(false)
  wpModifiedAt     DateTime?
  localEditedAt    DateTime?     // set when edited in the new CMS; importer will not overwrite
  wpMeta           Json?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  categories Category[]
  tags       Tag[]
  businesses ArticleBusiness[]
  revisions  ArticleRevision[]

  @@unique([wpType, wpId])
  @@index([status, publishedAt])
  @@index([kind])
}

model ArticleBusiness {
  articleId  String
  businessId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([articleId, businessId])
}

model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title     String
  excerpt   String?
  content   String
  note      String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
}

model Page {
  id               String        @id @default(cuid())
  wpId             Int?          @unique
  slug             String        @unique
  title            String
  content          String
  originalContent  String?
  featuredImageUrl String?
  status           ArticleStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  showInNav        Boolean       @default(false)
  legacyPath       String?       @unique
  localEditedAt    DateTime?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// ───────────────────────────── Events ─────────────────────────────

enum EventStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  UNPUBLISHED
  ARCHIVED
}

model EventCategory {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  events    Event[]
}

model Event {
  id              String         @id @default(cuid())
  wpId            Int?           @unique
  slug            String         @unique
  title           String
  description     String?        // HTML
  imageUrl        String?
  startAt         DateTime
  endAt           DateTime?
  allDay          Boolean        @default(false)
  // Recurrence: { freq: "DAILY"|"WEEKLY"|"MONTHLY", interval: 1, until: ISO, count?: n }
  recurrence      Json?
  locationName    String?
  address         String?
  city            String?
  organizer       String?
  businessId      String?
  business        Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ticketUrl       String?
  isFree          Boolean        @default(true)
  price           String?
  status          EventStatus    @default(PENDING)
  isFeatured      Boolean        @default(false)
  isSponsored     Boolean        @default(false)
  submittedById   String?
  submittedBy     User?          @relation("EventSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  submitterEmail  String?
  rejectionReason String?
  dedupeKey       String?        @unique
  /// Resident-friendly attributes: family, indoor, outdoor, fundraiser, church, music, food, market…
  tags            String[]       @default([])
  /// Optional vendor information for markets, craft shows and vendor events (plain text).
  vendorInfo      String?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, startAt])
  @@index([organizationId])
}

// ───────────────────────────── Promotions ─────────────────────────────

enum PromotionStatus {
  DRAFT
  PENDING
  APPROVED      // becomes Scheduled / Active / Expired based on dates
  REJECTED
  UNPUBLISHED
}

model Promotion {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  description     String?
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  imageUrl        String?
  startsAt        DateTime        @default(now())
  endsAt          DateTime?
  terms           String?
  couponCode      String?
  redemptionLimit Int?
  status          PromotionStatus @default(PENDING)
  isFeatured      Boolean         @default(false)
  isSponsored     Boolean         @default(false)
  rejectionReason String?
  createdById     String?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  redemptions PromotionRedemption[]

  @@index([status, startsAt, endsAt])
}

model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, userId])
}

// ───────────────────────────── Jobs ─────────────────────────────

model Job {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  businessId     String?
  business       Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  employerName   String?
  description    String?
  employmentType String?
  location       String?
  payRange       String?
  applyUrl       String?
  applyEmail     String?
  status         PublishStatus @default(PENDING)
  isSponsored    Boolean       @default(false)
  expiresAt      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ───────────────────────────── Community members ─────────────────────────────

enum SavedType {
  BUSINESS
  EVENT
  PROMOTION
  ARTICLE
  GARAGE_SALE
  ORGANIZATION
  PULSE
}

model SavedItem {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SavedType
  targetId  String
  createdAt DateTime  @default(now())

  @@unique([userId, type, targetId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  categories String[] @default([])
  createdAt  DateTime @default(now())
}

// Real, recorded engagement. Never fabricated.
model EngagementEvent {
  id         String   @id @default(cuid())
  type       String   // view_business, view_event, view_promotion, view_article, click_website, click_phone, click_directions, save
  businessId String?
  targetType String?
  targetId   String?
  visitorHash String?
  createdAt  DateTime @default(now())

  @@index([businessId, type, createdAt])
  @@index([targetType, targetId])
  @@index([type, createdAt])
  @@index([createdAt])
}

// ───────────────────────────── Site management ─────────────────────────────

enum MenuLocation {
  HEADER
  FOOTER
  MOBILE
}

model MenuItem {
  id           String       @id @default(cuid())
  location     MenuLocation
  label        String
  href         String
  parentId     String?
  sortOrder    Int          @default(0)
  isVisible    Boolean      @default(true)
  openInNewTab Boolean      @default(false)
  createdAt    DateTime     @default(now())
}

model HomepageSection {
  id          String   @id @default(cuid())
  key         String   @unique
  type        String   // hero, explore, weekend, events, businesses, spotlights, specials, things_to_do, announcements, banner
  title       String
  subtitle    String?
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  limit       Int      @default(6)
  featuredIds String[] @default([])
  config      Json?
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Media {
  id          String    @id @default(cuid())
  key         String    @unique   // storage key
  url         String
  filename    String
  mimeType    String
  size        Int       @default(0)
  width       Int?
  height      Int?
  alt         String?
  caption     String?
  title       String?
  wpId        Int?      @unique
  sourceUrl   String?   @unique   // original WordPress URL (dedupe key for migrations)
  uploadedById String?
  uploadedBy  User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// Database-backed object storage, used when no S3 bucket is configured.
model MediaBlob {
  key       String   @id
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  source     String   @default("manual") // manual | migration
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ───────────────────────────── Memberships & payments ─────────────────────────────

enum PlanInterval {
  FREE
  MONTH
  YEAR
}

model MembershipPlan {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  description   String?
  priceCents    Int          @default(0)
  interval      PlanInterval @default(MONTH)
  features      String[]     @default([])
  // { promotions: bool, events: bool, updates: bool, analytics: bool, maxPhotos: int }
  entitlements  Json
  stripePriceId String?
  isActive      Boolean      @default(false)
  isPublic      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

model Subscription {
  id                   String             @id @default(cuid())
  businessId           String
  business             Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId               String
  plan                 MembershipPlan     @relation(fields: [planId], references: [id])
  source               String             @default("stripe") // stripe | manual
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([businessId, status])
}

model Payment {
  id               String   @id @default(cuid())
  businessId       String?
  business         Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  stripeInvoiceId  String?  @unique
  stripeSessionId  String?  @unique
  amountCents      Int
  currency         String   @default("usd")
  status           String
  description      String?
  hostedInvoiceUrl String?
  paidAt           DateTime?
  createdAt        DateTime @default(now())
}

model SponsorshipProduct {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  type          String      // featured_placement, event_sponsorship, weekend_guide, job_listing, category_sponsorship, promotional_placement
  description   String?
  priceCents    Int         @default(0)
  durationDays  Int         @default(30)
  stripePriceId String?
  isActive      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  placements    Placement[]
}

model Placement {
  id         String              @id @default(cuid())
  businessId String?
  business   Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String?
  product    SponsorshipProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  slot       String              // homepage_featured, weekend_guide, category:<slug>, events
  title      String?
  imageUrl   String?
  linkUrl    String?
  startsAt   DateTime            @default(now())
  endsAt     DateTime?
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
}

model StripeEvent {
  id          String   @id // Stripe event id — guarantees idempotent webhook handling
  type        String
  processedAt DateTime @default(now())
}

// ───────────────────────────── WordPress migration ─────────────────────────────

model MigrationRun {
  id         String    @id @default(cuid())
  source     String    // rest | wxr
  status     String    @default("running") // running | completed | failed
  options    Json?
  report     Json?
  log        String    @default("")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

model WpRecord {
  id         String   @id @default(cuid())
  wpType     String
  wpId       Int
  title      String?
  status     String   // imported | failed | skipped | preserved_local_edits
  wpStatus   String?
  targetType String?
  targetId   String?
  sourceUrl  String?
  newPath    String?
  error      String?
  updatedAt  DateTime @updatedAt

  @@unique([wpType, wpId])
}

// ───────────────────────────── T-County Gives (nonprofits & churches) ─────────────────────────────
// Nonprofits and churches are always free: no plans, subscriptions or
// entitlements are ever attached to an Organization.

enum OrgKind {
  NONPROFIT
  CHURCH
  COMMUNITY_GROUP
}

enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

/// Who manages the listing — independent of publication/moderation status.
enum OrgOwnership {
  UNCLAIMED      // created by an administrator or import; no verified manager
  CLAIM_PENDING  // someone has requested management access
  CLAIMED        // at least one verified representative manages it
}

enum OrgMemberRole {
  OWNER
  ADMIN
  EDITOR
}

model Organization {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  kind             OrgKind   @default(NONPROFIT)
  orgType          String?   // e.g. "Food pantry", "Animal rescue", "501(c)(3)"
  tagline          String?
  description      String?   // HTML
  mission          String?
  impact           String?   // HTML — community impact
  logoUrl          String?
  coverUrl         String?
  coverFocusX      Int       @default(50) // cover focal point, % from left (0–100)
  coverFocusY      Int       @default(50) // cover focal point, % from top (0–100)
  email            String?
  emailPublic      Boolean   @default(true)
  phone            String?
  website          String?
  socials          Json?
  address          String?
  city             String?
  state            String?   @default("OH")
  zip              String?
  serviceArea      String?
  donationUrl      String?
  wishlistUrl      String?
  ein              String?   // never shown publicly unless verified
  // Church-specific (kind = CHURCH)
  denomination     String?
  leadership       Json?     // [{ name, role }]
  serviceTimes     Json?     // [{ day, time, label }]
  ministries       String[]  @default([])
  livestreamUrl    String?
  accessibility    String?
  planYourVisit    String?   // HTML
  // Moderation / verification
  status           OrgStatus @default(PENDING)
  // Publication is separate from moderation status and ownership:
  // public = status APPROVED && isPublished && not deleted.
  isPublished      Boolean   @default(true)
  publishedAt      DateTime?
  ownershipStatus  OrgOwnership @default(UNCLAIMED)
  source           String    @default("self_registered") // self_registered | admin | import
  importBatchId    String?
  createdById      String?
  internalNotes    String?
  // Content accuracy for staff-seeded listings
  sourceUrls       String[]  @default([]) // public sources the information came from
  infoCheckedAt    DateTime?              // when the public information was last checked
  imageRights      String?                // basis for using logo/cover (provided by org, licensed, own photo, ...)
  verifiedAt       DateTime?
  verifiedById     String?
  verificationNote String?
  reviewNote       String?
  isFeatured       Boolean   @default(false)
  seoTitle         String?
  seoDescription   String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members       OrganizationMember[]
  updates       OrganizationUpdate[]
  needs         CommunityNeed[]
  opportunities VolunteerOpportunity[]
  events        Event[]
  claims        OrganizationClaim[]
  pulseResults  PulseResult[]

  @@index([kind, status, deletedAt])
  @@index([ownershipStatus])
  @@index([importBatchId])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// A request from a signed-in person to manage an existing organization listing.
/// Contains personal information — visible only to the claimant and staff.
model OrganizationClaim {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantName      String
  email              String       // organization email the applicant controls (verified by link)
  phone              String?
  role               String       // e.g. Pastor, Executive Director, Board member
  verificationMethod String?      // how staff can confirm: official email, phone callback, document, etc.
  evidence           String?      // free text: links, notes
  message            String?
  emailDomainMatches Boolean      @default(false) // email domain matches the listing website
  emailVerifiedAt    DateTime?
  verifyTokenHash    String?      @unique
  verifyExpiresAt    DateTime?
  status             ClaimStatus  @default(PENDING)
  reviewNote         String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([status, createdAt])
}

/// A bulk CSV import of organization listings (staged → mapped → imported).
model OrganizationImport {
  id          String    @id @default(cuid())
  filename    String
  status      String    @default("uploaded") // uploaded | mapped | imported | failed
  headers     String[]  @default([])
  rows        Json      // raw parsed rows (array of string arrays)
  mapping     Json?     // { csvColumnIndex: fieldName }
  defaults    Json?     // { kind, isPublished }
  results     Json?     // per-row outcome: created | skipped_duplicate | skipped_claimed | error
  summary     Json?
  createdById String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model OrganizationMember {
  userId         String
  organizationId String
  role           OrgMemberRole @default(OWNER)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@id([userId, organizationId])
}

model OrganizationUpdate {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  body           String
  imageUrl       String?
  status         PublishStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum NeedCategory {
  VOLUNTEERS
  SUPPLIES
  FOOD
  CLOTHING
  EQUIPMENT
  HYGIENE
  SCHOOL
  FUNDRAISER
  OUTREACH
  OTHER
}

enum NeedUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NeedStatus {
  DRAFT
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CLOSED
}

model CommunityNeed {
  id               String       @id @default(cuid())
  slug             String       @unique
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  category         NeedCategory @default(SUPPLIES)
  quantityNeeded   Int?
  unit             String?
  quantityReceived Int          @default(0) // confirmed by the organization only
  deadline         DateTime?
  urgency          NeedUrgency  @default(MEDIUM)
  instructions     String?
  dropoffLocation  String?
  /// Community for location filtering; falls back to the organization's city
  city             String?
  status           NeedStatus   @default(OPEN)
  isWishList       Boolean      @default(false)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  pledges NeedPledge[]

  @@index([status, deadline])
}

enum PledgeStatus {
  PLEDGED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

/// Contains personal information — visible only to the organization's team and staff.
model NeedPledge {
  id               String       @id @default(cuid())
  needId           String
  need             CommunityNeed @relation(fields: [needId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  email            String
  phone            String?
  quantity         Int          @default(1)
  message          String?
  status           PledgeStatus @default(PLEDGED)
  receivedQuantity Int?
  confirmedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([needId, status])
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

model VolunteerOpportunity {
  id               String            @id @default(cuid())
  slug             String            @unique
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  startAt          DateTime?
  endAt            DateTime?
  isOngoing        Boolean           @default(false)
  locationName     String?
  address          String?
  city             String?
  minAge           Int?
  ageNotes         String?
  spots            Int?
  requirements     String?
  registrationOpen Boolean           @default(true)
  externalSignupUrl String?
  status           OpportunityStatus @default(PUBLISHED)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  signups VolunteerSignup[]

  @@index([status, startAt])
}

enum SignupStatus {
  REGISTERED
  WAITLISTED
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

/// Contains personal information — visible only to the organization's team and staff.
model VolunteerSignup {
  id            String               @id @default(cuid())
  opportunityId String
  opportunity   VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String?
  isAdult       Boolean              @default(true)
  notes         String?
  status        SignupStatus         @default(REGISTERED)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([opportunityId, email])
}

// ───────────────────────────── T-County Weekly (newsletter) ─────────────────────────────

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

model NewsletterSubscriber {
  id                 String           @id @default(cuid())
  email              String           @unique // normalized (trimmed, lowercased)
  firstName          String?
  status             SubscriberStatus @default(PENDING)
  source             String           // homepage, footer, article, event, pwa, account, newsletter_page, admin_import
  consentAt          DateTime?
  consentText        String?
  consentVersion     String?
  confirmTokenHash   String?          @unique
  confirmExpiresAt   DateTime?
  confirmedAt        DateTime?
  unsubscribeToken   String           @unique // random capability token used in every email
  unsubscribedAt     DateTime?
  unsubscribeReason  String?
  preferences        Json?            // { events, stories, spotlights, specials, gives }
  /// Communities this subscriber cares about (TUSCARAWAS_CITIES values); empty = all of Tuscarawas County
  communities        String[]         @default([])
  userId             String?          @unique
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  events SubscriberEvent[]
  sends  NewsletterSend[]

  @@index([status, source])
}

/// Permanent do-not-email list. Survives subscriber deletion so people are never re-imported.
model EmailSuppression {
  email     String   @id
  reason    String   // unsubscribed, bounced, complained, manual
  createdAt DateTime @default(now())
}

model SubscriberEvent {
  id           String               @id @default(cuid())
  subscriberId String
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  type         String               // signup, confirm_sent, confirmed, welcome_sent, unsubscribed, resubscribed, preferences, sent, delivered, bounced, complained, opened, clicked
  data         Json?
  createdAt    DateTime             @default(now())

  @@index([subscriberId, createdAt])
}

enum NewsletterStatus {
  DRAFT
  APPROVED
  SCHEDULED
  SENDING
  SENT
  CANCELED
  FAILED
}

model Newsletter {
  id           String           @id @default(cuid())
  subject      String
  preheader    String?
  content      Json             // { intro, sections: [{ type, title, items: [...] }], outro }
  status       NewsletterStatus @default(DRAFT)
  scheduledFor DateTime?
  approvedById String?
  approvedAt   DateTime?
  sendStartedAt DateTime?
  sentAt       DateTime?
  createdById  String?
  recipientCount Int            @default(0)
  stats        Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sends NewsletterSend[]
}

enum SendStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
  BOUNCED
  COMPLAINED
  SKIPPED
}

model NewsletterSend {
  id                String               @id @default(cuid())
  newsletterId      String
  newsletter        Newsletter           @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  subscriberId      String
  subscriber        NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status            SendStatus           @default(QUEUED)
  providerMessageId String?              @unique
  error             String?
  sentAt            DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([newsletterId, subscriberId]) // duplicate-send prevention
  @@index([newsletterId, status])
}

// ───────────────────────────── Community Pulse ─────────────────────────────
// Community recommendations compiled manually (e.g. from a Facebook discussion).
// Mention counts are community opinion, never ratings: no review/rating schema,
// and never influenced by paid memberships.

enum PulseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PulseSourceType {
  FACEBOOK
  COMMUNITY_SUBMISSION
  SURVEY
  EDITORIAL
  OTHER
}

enum PulseDisplayMode {
  RANKED_LIST     // numbered list with mention counts
  BARS            // comparison bars sized by mentions
  EDITORIAL_LIST  // no counts / ranking (curated list)
}

enum PulseSortMode {
  MENTIONS_DESC
  MANUAL
}

model PulseCategory {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  pulses    CommunityPulse[]
}

model CommunityPulse {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  description        String?          // short summary for cards
  intro              String?          // HTML (sanitized) longer introduction
  featuredImageUrl   String?
  featuredImageAlt   String?
  categoryId         String?
  category           PulseCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceType         PulseSourceType  @default(FACEBOOK)
  sourceUrl          String?          // original discussion URL (Facebook post, survey, ...)
  sourceLabel        String?          // e.g. "T County Connect Facebook group"
  methodology        String?          // how counts were compiled (duplicates combined, etc.)
  discussionDate     DateTime?        // when the conversation happened (editable)
  resultsUpdatedAt   DateTime?        // public "results last updated" (editable)
  publishedAt        DateTime?        // public publication date (editable)
  status             PulseStatus      @default(DRAFT)
  isFeatured         Boolean          @default(false)
  displayMode        PulseDisplayMode @default(RANKED_LIST)
  sortMode           PulseSortMode    @default(MENTIONS_DESC)
  homepageLimit      Int              @default(3)
  seoTitle           String?
  seoDescription     String?
  ogImageUrl         String?
  // Internal, system-managed audit timestamps — never editable, never faked.
  firstPublishedAt   DateTime?        // set once, the first time it goes public
  resultsChangedAt   DateTime?        // set automatically whenever results change
  createdById        String?
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  results PulseResult[]

  @@index([status, publishedAt])
  @@index([isFeatured])
}

model PulseResult {
  id             String         @id @default(cuid())
  pulseId        String
  pulse          CommunityPulse @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  name           String
  mentions       Int?           // null for editorial lists
  description    String?
  imageUrl       String?
  websiteUrl     String?
  businessId     String?
  business       Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([pulseId, sortOrder])
  @@index([businessId])
  @@index([organizationId])
}

// ───────────────────────────── Listing access invitations ─────────────────────────────

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Email invitation to manage a business or organization listing. The token is
/// single-use and expiring; only its SHA-256 hash is stored.
model AccountInvitation {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  email          String
  tokenHash      String           @unique
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  acceptedAt     DateTime?
  businessId     String?
  organizationId String?
  role           String           // "OWNER" | "MANAGER" (business) or OWNER | ADMIN | EDITOR (organization)
  invitedById    String?
  invitedBy      User?            @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  sendCount      Int              @default(1)
  lastSentAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, status])
  @@index([businessId])
  @@index([organizationId])
}

// ───────────────────────────── Services & menus (Premium) ─────────────────────────────
// Kept when a membership lapses; shown publicly only while the listing has the
// servicesMenus entitlement.

enum OfferingKind {
  SERVICES
  MENU
}

model BusinessOfferingSection {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind        OfferingKind   @default(SERVICES)
  title       String         // e.g. "Services", "Breakfast", "Brake repair"
  description String?
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items BusinessOfferingItem[]

  @@index([businessId, sortOrder])
}

model BusinessOfferingItem {
  id          String                  @id @default(cuid())
  sectionId   String
  section     BusinessOfferingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       String?                 // free text: "$12", "from $40", "Market price"
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([sectionId, sortOrder])
}

// ───────────────────────────── Food Truck Tracker ─────────────────────────────
// Scheduled serving stops entered by the truck's owner/manager or an admin.
// A scheduled time is NOT proof a truck is there: `confirmedAt` is only set
// when the owner confirms on the day.

enum FoodTruckStopStatus {
  SCHEDULED
  CANCELLED
}

model FoodTruckStop {
  id           String              @id @default(cuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  startAt      DateTime
  endAt        DateTime
  locationName String              // "Tuscora Park", "Dover Walmart parking lot"
  address      String?
  city         String?
  notes        String?
  status       FoodTruckStopStatus @default(SCHEDULED)
  cancelledAt  DateTime?
  confirmedAt  DateTime?           // owner confirmed "we're serving" for this stop
  seriesId     String?             // stops created together from a weekly schedule
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([startAt, status])
  @@index([businessId, startAt])
  @@index([seriesId])
}

// ───────────────────────────── Garage & yard sales ─────────────────────────────
// Resident submissions. Submitter email is private (moderation + manage link).
// Sales drop out of active listings automatically after their end date.

enum GarageSaleType {
  GARAGE
  YARD
  MULTI_FAMILY
  ESTATE
  CHURCH_RUMMAGE
  COMMUNITY_WIDE
  OTHER
}

enum GarageSaleStatus {
  PENDING
  PUBLISHED
  REJECTED
  REMOVED
}

enum AddressVisibility {
  EXACT    // street address shown publicly
  GENERAL  // only the general location / cross streets shown
}

model GarageSale {
  id                String            @id @default(cuid())
  slug              String            @unique
  title             String
  description       String?
  saleType          GarageSaleType    @default(GARAGE)
  itemCategories    String[]          @default([])
  address           String?           // private unless addressVisibility = EXACT
  generalLocation   String?           // public, e.g. "Near Front Ave & 3rd St"
  addressVisibility AddressVisibility @default(GENERAL)
  city              String?
  zip               String?
  startDate         DateTime          // first sale day (America/New_York midnight)
  endDate           DateTime          // last sale day
  dailyStart        String            // "08:00"
  dailyEnd          String            // "14:00"
  photos            String[]          @default([])
  submitterName     String?           // private
  submitterEmail    String            // private, never shown publicly
  userId            String?           // set when submitted by a signed-in account
  manageTokenHash   String?           @unique // secure edit/removal link (hash only)
  status            GarageSaleStatus  @default(PENDING)
  rejectionReason   String?
  reviewedById      String?
  reviewedAt        DateTime?
  publishedAt       DateTime?
  removedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, endDate])
  @@index([city])
}


// ───────────────────────────── Phase 3: local discovery ─────────────────────────────

/// Admin-curated Explore T County collection ("Free Things to Do", "Rainy Day Activities", ...)
model ExploreCollection {
  id            String                  @id @default(cuid())
  slug          String                  @unique
  title         String
  description   String?
  coverImageUrl String?
  coverFocusX   Int                     @default(50)
  coverFocusY   Int                     @default(50)
  status        PublishStatus           @default(DRAFT)
  isFeatured    Boolean                 @default(false)
  sortOrder     Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  items         ExploreCollectionItem[]

  @@index([status, sortOrder])
}

enum CollectionItemType {
  BUSINESS
  ARTICLE
  EVENT
  ORGANIZATION
  PULSE
  PLACE
}

/// One entry in a collection: a link to an existing record, or a PLACE (park, trail, site)
/// entered by staff with verified details.
model ExploreCollectionItem {
  id           String             @id @default(cuid())
  collectionId String
  collection   ExploreCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  itemType     CollectionItemType
  targetId     String?
  /// PLACE fields (also optional overrides for linked records)
  title        String?
  description  String?
  imageUrl     String?
  address      String?
  city         String?
  websiteUrl   String?
  note         String?
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([collectionId, sortOrder])
}

/// Optional admin content for a community (town) page. Pages exist for every community;
/// this only adds a cover image and introduction.
model CommunityProfile {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  intro         String?
  coverImageUrl String?
  coverFocusX   Int      @default(50)
  coverFocusY   Int      @default(50)
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum SuggestionKind {
  BUSINESS_OPENING
  COMMUNITY_UPDATE
  ATTRACTION
  VOLUNTEER
  OTHER
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Resident suggestions that staff verify before anything is published.
model CommunitySuggestion {
  id              String           @id @default(cuid())
  kind            SuggestionKind
  title           String
  details         String
  city            String?
  address         String?
  linkUrl         String?
  eventDate       DateTime?
  photos          String[]         @default([])
  /// Private submitter info — staff only
  submitterName   String?
  submitterEmail  String
  userId          String?
  manageTokenHash String?          @unique
  status          SuggestionStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  /// What staff created from it (e.g. "BusinessUpdate:<id>", "Article:<id>")
  resultRef       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, createdAt])
}


// ───────────────────────────── Phase 4: retention ─────────────────────────────

/// One row per opt-in email actually sent (weekend summary, saved-event reminder, new-in-my-communities).
/// The unique key makes sending idempotent: a cron re-run never emails the same thing twice.
model NotificationDelivery {
  id        String   @id @default(cuid())
  /// Member user id, or "sub:<subscriberId>" for newsletter-only subscribers
  recipient String
  kind      String   // weekend_summary | saved_event_reminders | new_in_my_communities
  /// What was sent, e.g. "2026-11-14" (weekend) or "EVENT:<id>:2026-11-14" (reminder)
  refKey    String
  status    String   @default("sent") // sent | failed | skipped
  error     String?
  createdAt DateTime @default(now())

  @@unique([recipient, kind, refKey])
  @@index([kind, createdAt])
}
